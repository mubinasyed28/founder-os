# Cofoundr OS Environment Variables
# Copy this to .env and fill in your values

# Mistral AI API Key (get from https://console.mistral.ai/)
MISTRAL_API_KEY=

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# MongoDB Database Name
MONGODB_DB_NAME=cofoundr_os
