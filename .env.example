# Cofoundr OS Environment Variables
# Copy this to .env and fill in your values

# Mistral AI API Key (get from https://console.mistral.ai/)
MISTRAL_API_KEY=

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# MongoDB Database Name
MONGODB_DB_NAME=cofoundr_os

# Tavily Web Search API Key (get from https://tavily.com)
TAVILY_API_KEY=

# Render Deployment & Remote Backend Connection
# When backend is deployed to Render, set this in your frontend .env:
# VITE_API_URL=https://your-backend-app.onrender.com
VITE_API_URL=

# Allowed CORS Origins for FastAPI backend (comma-separated list of origins or leave blank for permissive regex)
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGINS=
